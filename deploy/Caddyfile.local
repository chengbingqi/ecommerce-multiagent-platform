{
  admin localhost:2019
}

(local_app) {
  encode zstd gzip

  @api path /api/*
  handle @api {
    reverse_proxy api:8000
  }

  handle {
    root * /srv
    try_files {path} /index.html
    file_server
  }

  header {
    X-Content-Type-Options nosniff
    X-Frame-Options DENY
    Referrer-Policy strict-origin-when-cross-origin
  }
}

http://localhost {
  import local_app
}

https://localhost {
  tls internal
  import local_app
}

FROM mwader/static-ffmpeg:7.1.1-amd64@sha256:6769881cc02c80d33e387750a8e144d162adfab2775e934dd97899261dda3a0c AS ffmpeg

FROM python:3.12-slim@sha256:57cd7c3a7a273101a6485ba99423ee568157882804b1124b4dd04266317710de AS runtime

ARG PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    OMP_NUM_THREADS=8 \
    CT2_NUM_THREADS=8 \
    HF_HOME=/data/models/asr \
    LD_LIBRARY_PATH=/usr/local/lib/python3.12/site-packages/nvidia/cublas/lib:/usr/local/lib/python3.12/site-packages/nvidia/cudnn/lib

WORKDIR /app

COPY --from=ffmpeg /ffmpeg /usr/local/bin/ffmpeg
COPY --from=ffmpeg /ffprobe /usr/local/bin/ffprobe

RUN groupadd --system --gid 10001 app \
    && useradd --system --uid 10001 --gid app --home-dir /app app

COPY pyproject.toml ./pyproject.toml
COPY app ./app
COPY mcp_servers ./mcp_servers
COPY --chown=app:app fonts /app/fonts
RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip install --index-url "$PIP_INDEX_URL" --timeout 120 --retries 3 \
    "pip==26.1.2" ".[stage5-worker]"
RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip install --index-url "$PIP_INDEX_URL" --timeout 120 --retries 3 \
    "langchain-core==1.4.9" \
    "langgraph==1.2.9" \
    "langgraph-checkpoint-postgres==3.1.0"
COPY scripts ./scripts

USER app

CMD ["celery", "-A", "app.worker.celery_app:celery_app", "worker", "--queues=media", "--concurrency=1", "--prefetch-multiplier=1", "--loglevel=INFO"]

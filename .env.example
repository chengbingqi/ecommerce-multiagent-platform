# Copy this file to .env, then replace every CHANGE_ME / YOUR_* value.
# Keep .env local: it is intentionally ignored by Git.

APP_ENV=development
DATA_ROOT=YOUR_EXTERNAL_DATA_DIRECTORY_HERE
PROJECT_UID=CHANGE_ME
PROJECT_GID=CHANGE_ME

POSTGRES_DB=ecommerce_agent
POSTGRES_USER=ecommerce_agent
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql+asyncpg://ecommerce_agent:CHANGE_ME@postgres:5432/ecommerce_agent

REDIS_PASSWORD=CHANGE_ME
REDIS_URL=redis://:CHANGE_ME@redis:6379/0

AGENT_LLM_MODE=fake
DEEPSEEK_API_KEY=YOUR_API_KEY_HERE
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
LLM_TIMEOUT_SECONDS=20
LLM_MAX_TOKENS=800
LLM_TEMPERATURE=0.1
LLM_MAX_RETRIES=1
LLM_MAX_CALLS_PER_RUN=3
RUN_LIVE_LLM_TESTS=0

AGENT_MAX_STEPS=12
AGENT_DEADLINE_SECONDS=25
ORCHESTRATOR_MAX_SUBTASKS=3
ORCHESTRATOR_MAX_HOPS=1
ORCHESTRATOR_MAX_STEPS=16
ORCHESTRATOR_DEADLINE_SECONDS=55
ORCHESTRATOR_SUBTASK_TIMEOUT_SECONDS=20
ORCHESTRATOR_ROUTE_VERSION=orchestrator_route_v1.0.0
ORCHESTRATOR_PLAN_VERSION=orchestrator_plan_v1.0.0

ENABLE_DEV_PRINCIPAL_INPUT=true
ENFORCE_STAGE7_SECURITY=false
SESSION_SECRET_FILE=
CSRF_SECRET_FILE=
SESSION_COOKIE_NAME=ecom_session
SECURE_SESSION_COOKIE=false
SESSION_IDLE_SECONDS=1800
SESSION_ABSOLUTE_SECONDS=28800
ALLOWED_HOSTS=localhost,127.0.0.1
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
TRUSTED_PROXY_CIDRS=127.0.0.1/32
PUBLIC_BASE_URL=http://localhost:8080
PUBLIC_DOMAIN=example.invalid

RATE_GENERAL_PER_MINUTE=120
RATE_LOGIN_PER_15_MINUTES=5
RATE_RUN_PER_MINUTE=10
RATE_MODEL_DAILY=200
RATE_SSE_CONCURRENT=3
RATE_UPLOAD_DAILY=10
RATE_MEDIA_DAILY=5
RATE_APPROVAL_PER_MINUTE=10
RATE_DOWNLOAD_PER_MINUTE=30
MEDIA_STORAGE_QUOTA_BYTES=5368709120
DISK_UPLOAD_WARN_PERCENT=70
DISK_UPLOAD_STOP_PERCENT=85

MEDIA_ENABLED=false
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_SECURE=false
MEDIA_ORIGINAL_BUCKET=media-original
MEDIA_DERIVED_BUCKET=media-derived
MEDIA_QUARANTINE_BUCKET=media-quarantine
MEDIA_UPLOAD_MAX_BYTES=209715200
MEDIA_MAX_DURATION_SECONDS=600
MEDIA_MAX_PENDING_UPLOADS=3
MEDIA_WORKER_CONCURRENCY=1
MEDIA_TASK_SOFT_LIMIT_SECONDS=1200
MEDIA_TASK_HARD_LIMIT_SECONDS=1500
MEDIA_SUBPROCESS_TIMEOUT_SECONDS=300
MEDIA_PIPELINE_VERSION=media_pipeline_v1.2.1

ASR_MODEL=Systran/faster-whisper-large-v3
ASR_MODEL_ID=large-v3
ASR_MODEL_VERSION=edaa852ec7e145841d8ffdb056a99866b5f0a478
ASR_MODEL_REVISION=edaa852ec7e145841d8ffdb056a99866b5f0a478
ASR_MODEL_PATH=/data/models/asr/large-v3
ASR_DEVICE=cuda
ASR_DEVICE_INDEX=0
ASR_COMPUTE_TYPE=float16
ASR_CPU_THREADS=8
MEDIA_GPU_DEVICE_ID=YOUR_GPU_DEVICE_ID_HERE

# Production-only backup and secret-file paths. Leave empty for local development.
BACKUP_RETENTION_DAYS=7
EXTERNAL_BACKUP_TARGET=
